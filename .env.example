# Copy this file to .env and fill in your own key. Never commit .env.
DEEPSEEK_API_KEY=sk-your-key-here

# Optional
# DEEPSEEK_API_BASE=https://api.deepseek.com
# PORT=3210
# Set HOST=0.0.0.0 to allow LAN devices, and ALWAYS set a password then.
# HOST=127.0.0.1
# CHATBOX_USER=deepseek
# CHATBOX_PASSWORD=use-a-long-random-password
